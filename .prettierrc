{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 140,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["**/.*rc", "**/*.json"],
      "options": {
        "parser": "json"
      }
    },
    {
      "files": ["test/execution.js"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
